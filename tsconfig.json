{
    "extends": "@tsconfig/strictest/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "outDir": "dist",
        "rootDir": "src",
        "lib": ["es2015"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "allowImportingTsExtensions": true
    },
    "include": ["src"]
}
